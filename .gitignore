# ==========================================
# ClefVoice .gitignore
# ==========================================

# --- Operating System & Environments ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
ehthumbs.db
Thumbs.db

# --- Environment & Local Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# --- Node.js & React Web UI ---
node_modules/
app/node_modules/
app/dist/
app/dist-ssr/
app/dist-electron/
app/.vite/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Go Core Engine (clefd) & CGO / whisper.cpp ---
core/build/
core/bin/
core/third_party/
build/
bin/
/clefd
/clefd.exe
core/clefd
core/clefd.exe
!core/cmd/clefd/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# --- Whisper Models (large binary models) ---
*.bin
*.onnx
*.gguf
*.mlmodelc/
/models/
Models/
# Keep Go model-manager sources and tests on case-insensitive macOS filesystems.
!core/internal/models/

# --- Swift & macOS Native Helper ---
.build/
.swiftpm/
native/macos/.build/
*.swiftmodule
*.swiftdoc
*.swiftinterface
*.app/
*.dSYM/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# --- Windows Native (C# / Win32) ---
native/windows/bin/
native/windows/obj/
[Bb]in/
[Oo]bj/
*.user
*.suo

# --- IDEs & Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Release Archives & Installers ---
*.zip
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage
*.msi
